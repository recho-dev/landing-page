{
  "rewrites": [
    {
      "source": "/notebook/_vercel/insights/:path*",
      "destination": "https://recho-notebook.vercel.app/_vercel/insights/:path*"
    },
    {
      "source": "/notebook",
      "destination": "https://recho-notebook.vercel.app/notebook"
    },
    {
      "source": "/notebook/:path*",
      "destination": "https://recho-notebook.vercel.app/notebook/:path*"
    },
    {
      "source": "/melody",
      "destination": "https://recho-melody.vercel.app/melody"
    },
    {
      "source": "/melody/:path*",
      "destination": "https://recho-melody.vercel.app/melody/:path*"
    },
    {
      "source": "/multiples",
      "destination": "https://recho-multiples.vercel.app/multiples"
    },
    {
      "source": "/multiples/:path*",
      "destination": "https://recho-multiples.vercel.app/multiples/:path*"
    }
  ]
}
